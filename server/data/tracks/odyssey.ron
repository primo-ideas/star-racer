        Turn(angle: -60.0, radius: 90.0, transition: 22.0, banking: 16.0),
        Turn(angle: 30.0, radius: 90.0, transition: 22.0, banking: 12.0),
        // The step.
        Straight(length: 150.0),
        // The west corner, and the esses.
        Turn(angle: 90.0, radius: 70.0, transition: 26.0, banking: 26.0),
        Straight(length: 80.0),
        Turn(angle: -40.0, radius: 80.0, transition: 22.0, banking: 16.0),
        Turn(angle: 80.0, radius: 80.0, transition: 22.0, banking: 20.0),
        Turn(angle: -40.0, radius: 80.0, transition: 22.0, banking: 16.0),
        Straight(length: 60.0),
        // The long way round.
        Turn(angle: -108.0, radius: 40.0, transition: 20.0, banking: 20.0),
        Straight(length: 25.0),
        Turn(angle: 216.0, radius: 52.0, transition: 26.0, banking: 30.0),
        Straight(length: 25.0),
        Turn(angle: -108.0, radius: 40.0, transition: 20.0, banking: 20.0),
